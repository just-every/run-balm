{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime",
        "node --test --test-concurrency=1 tests/mobile.test.mjs"
      ]
    },
    {
      "name": "domain",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:balm"
      ]
    },
    {
      "name": "portability-core",
      "browser": false,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern=\"public CLI archive round trip|public CLI erasure journals|recorded diagnoses\" tests/archive.test.mjs"
      ]
    },
    {
      "name": "portability-backups",
      "browser": false,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern=\"HIPAA-004 automatic\" tests/archive.test.mjs"
      ]
    },
    {
      "name": "portability-roles",
      "browser": false,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern=\"CLI archive preserves jobs\" tests/archive.test.mjs"
      ]
    },
    {
      "name": "site",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:site"
      ]
    }
  ],
  "nightly": [
    {
      "name": "owned-clean-start",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/runtime.mjs --owned-clean-start"
      ]
    }
  ]
}
