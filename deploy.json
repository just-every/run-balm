{
  "version": 1,
  "project": "clinic/balm",
  "crons": [
    "* * * * *"
  ],
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "SMS_PROVIDER",
      "environment": "SMS_PROVIDER",
      "optional": true
    },
    {
      "binding": "TWILIO_ACCOUNT_SID",
      "environment": "TWILIO_ACCOUNT_SID",
      "optional": true
    },
    {
      "binding": "TWILIO_AUTH_TOKEN",
      "environment": "TWILIO_AUTH_TOKEN",
      "optional": true
    },
    {
      "binding": "TWILIO_FROM",
      "environment": "TWILIO_FROM",
      "optional": true
    },
    {
      "binding": "BALM_INSURANCE_ADAPTER_URL",
      "environment": "BALM_INSURANCE_ADAPTER_URL",
      "optional": true
    },
    {
      "binding": "BALM_INSURANCE_ADAPTER_TOKEN",
      "environment": "BALM_INSURANCE_ADAPTER_TOKEN",
      "optional": true
    },
    {
      "binding": "BALM_RESEND_WEBHOOK_KEY",
      "environment": "BALM_RESEND_WEBHOOK_KEY",
      "optional": true
    },
    {
      "binding": "BALM_RESEND_EVENT_NAMESPACE",
      "environment": "BALM_RESEND_EVENT_NAMESPACE",
      "optional": true
    },
    {
      "binding": "BALM_SENDGRID_WEBHOOK_KEY",
      "environment": "BALM_SENDGRID_WEBHOOK_KEY",
      "optional": true
    },
    {
      "binding": "BALM_SENDGRID_EVENT_NAMESPACE",
      "environment": "BALM_SENDGRID_EVENT_NAMESPACE",
      "optional": true
    }
  ]
}
