{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinic-balm",
  "vars": {"AUTH_LOCAL":"false","AUTH_ORIGIN":"","MAIL_PROVIDER":"","MAIL_FROM":"","MAIL_RELAY_URL":"","MAIL_ACCOUNT_ID":""},
  "triggers": { "crons": ["* * * * *"] },
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ]
}
