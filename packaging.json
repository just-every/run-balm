{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-balm",
    "name": "Balm",
    "sourceRepository": "https://github.com/just-every/run-balm",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm check:deployment-spec && pnpm exec rer check --profile first-party",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/backup.md. Pause writes and scheduled work, retain the exact source revision and private settings, restore the owner-controlled encrypted backup into fresh empty resources, re-export and compare clinic data, then verify owner sign-in before routing traffic. Preserve all applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "IDENTITY_PROVIDER",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "INSTALLATION_KEY"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "SMS_PROVIDER",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_FROM",
        "BALM_INSURANCE_ADAPTER_URL",
        "BALM_INSURANCE_ADAPTER_TOKEN",
        "BALM_RESEND_WEBHOOK_KEY",
        "BALM_RESEND_EVENT_NAMESPACE",
        "BALM_SENDGRID_WEBHOOK_KEY",
        "BALM_SENDGRID_EVENT_NAMESPACE",
        "INSTALLATION_KEY_PREVIOUS"
      ],
      "healthPath": "/health",
      "recovery": "Follow docs/backup.md. Pause writes and scheduled work, retain the exact source revision and private settings, restore the owner-controlled encrypted backup into fresh empty resources, re-export and compare clinic data, then verify owner sign-in before routing traffic. Preserve all applied migration names and bytes.",
      "providerEffects": [
        "outbound-mail",
        "outbound-sms",
        "payments",
        "ai",
        "outbound-webhooks"
      ],
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
